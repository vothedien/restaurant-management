DATABASE_URL=postgresql+psycopg://username:password@host/database?sslmode=require
DATABASE_SCHEMA=restaurant_ai
APP_NAME=Restaurant Management API
APP_ENV=development
DEBUG=true
FRONTEND_URL=http://localhost:5173
JWT_SECRET_KEY=replace-with-a-local-development-secret
# Independent Inventory signing key: generate at least 32 random bytes.
# Never reuse JWT_SECRET_KEY. Empty keeps Inventory Auth unavailable (503).
INVENTORY_JWT_SECRET_KEY=
INVENTORY_JWT_ALGORITHM=HS256
INVENTORY_ACCESS_TOKEN_EXPIRE_MINUTES=480
